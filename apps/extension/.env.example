# Google OAuth client IDs for Drive sync. Copy to .env and fill in; see docs/google-setup.md.
# Leave empty to build without sync (everything else works).

# "Web application" client (all browsers via identity.launchWebAuthFlow; also the web app).
WXT_GOOGLE_CLIENT_ID_WEB=
# Optional "Chrome extension" client (identity.getAuthToken), used only when the Web one is empty.
WXT_GOOGLE_CLIENT_ID_CHROME=
# Optional: the public key that pins the unpacked Chrome extension's ID in development.
WXT_CHROME_EXTENSION_KEY=
