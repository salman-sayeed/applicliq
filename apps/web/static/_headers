# Cloudflare Pages response headers. The main Content-Security-Policy is a <meta> tag generated
# by SvelteKit (see vite.config.ts); frame-ancestors only works as a header. COOP allows popups
# because Google's sign-in popup reports back to the page.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Hashed build assets never change.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
