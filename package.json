{
  "name": "pocket-career",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source, lightweight job application tracker: browser extension + static dashboard. Your data stays local and in your own Google Drive.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @pocket-career/extension dev",
    "dev:web": "pnpm --filter @pocket-career/web dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:ext": "pnpm --filter @pocket-career/extension build:all",
    "deploy:web": "pnpm --filter @pocket-career/web build && pnpm dlx wrangler@4 pages deploy apps/web/build --project-name pocket-career",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -b && pnpm -r --if-present check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.58.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
